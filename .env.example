# Copia este archivo a .env y ajusta los valores para tu entorno local.
# El archivo .env está en .gitignore y nunca debe versionarse.

# Contraseña del usuario sa de SQL Server en el contenedor.
SA_PASSWORD=Your_strong_password123!

# Clave para firmar tokens JWT (mínimo 32 caracteres en base64).
JWT_KEY=ZmFrZS1qd3Qta2V5LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9u

# Connection string sobreescribe la de appsettings cuando se levanta vía docker compose.
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=HotelReservationsDB;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=true;Encrypt=False
